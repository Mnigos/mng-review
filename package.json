{
  "name": "mng-review",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "effect": "4.1.4",
      "@effect/platform-bun": "4.1.4",
      "@effect/vitest": "4.1.4",
      "@effect/ai-openai-compat": "4.1.4",
      "vitest": "5.0.3"
    }
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo test",
    "test:watch": "vitest",
    "check": "ultracite check",
    "check:fix": "ultracite fix --unsafe",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@mng-review/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.2",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.22.1",
    "npm": "please-use-bun",
    "yarn": "please-use-bun"
  },
  "packageManager": "bun@1.4.2"
}
